# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Environment / secrets
.env
*.pem

# Data — the real Kaggle dataset must never be committed (redistribution),
# and processed/rejected/manifest output is regenerated by the pipeline.
# creditcard_sample.csv (the bundled synthetic dataset) is intentionally
# NOT ignored — it's committed so the repo runs out of the box.
data/raw/creditcard.csv
data/raw/manifests/
data/processed/*
data/rejected/*
!data/processed/.gitkeep
!data/rejected/.gitkeep

# Trained model artifacts are build output, not source.
models/*.joblib
models/*.json
!models/.gitkeep

# Logs
*.log
logs/

# Airflow runtime state (docker-compose mounts these)
airflow/logs/
airflow/plugins/
airflow/airflow.db

# Docker
postgres-data/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Notebook execution scratch
notebooks/.ipynb_checkpoints/
