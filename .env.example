# Copy this file to .env and adjust as needed. .env is gitignored.

# --- Storage ---
# local: read/write data/ on disk (default, no AWS needed)
# s3: read/write the S3 bucket below, using standard AWS credential resolution
#     (env vars, ~/.aws/credentials, or an IAM role) — never put AWS keys in this file.
STORAGE_MODE=local

# Filename under data/raw/ the pipeline ingests. Ships pointing at the bundled
# synthetic sample. Switch to creditcard.csv after placing the real dataset there.
RAW_DATA_FILENAME=creditcard_sample.csv

# --- PostgreSQL (app database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudlens
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=fraudlens

# --- AWS (only read when STORAGE_MODE=s3) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- Airflow (docker-compose only) ---
# Airflow's own metadata database lives in the same Postgres instance as the
# app database, under a separate database name, to keep the local stack to
# one DB container.
AIRFLOW_DB=airflow
AIRFLOW_UID=50000
# Local Airflow UI login only (http://localhost:8080) - not a production secret.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
